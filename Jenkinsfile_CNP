#!groovy
@Library("Infrastructure")

def type = "nodejs"
def product = "dcs-automation"
def component = "sds"
def channel = "#dcs-automation"

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

withNightlyPipeline(type, product, component) {

  enableSlackNotifications(channel)

  afterAlways('DependencyCheckNightly') {

    stage('Lint') {
      try {
        yarnBuilder.yarn('lint')
      } catch (Error) {
        unstable(message: "${STAGE_NAME} is unstable: " + Error.toString())
      }
    }

    stage('Run Changed Playwright Tests') {
      try {

        def changedTests = sh(
          script: """
            git fetch origin master:master
            BASE=\$(git merge-base HEAD master)
            git diff --name-only \$BASE...HEAD \
              | grep 'tests/.*\\.spec\\.ts\$' || true
          """,
          returnStdout: true
        ).trim()

        echo "Changed test files detected:"
        echo "${changedTests}"

        if (changedTests?.trim()) {

          def testFiles = changedTests
            .split("\\n")
            .collect { it.trim() }
            .findAll { it }

          echo "Running Playwright tests:"
          echo testFiles.join(", ")

          yarnBuilder.yarn("""
            playwright test ${testFiles.join(' ')} \
              --project=chrome \
              --grep-invert='(@a11y)|(@performance)|(@visual)'
          """)

        } else {

          echo "No changed spec files detected"
          throw new Exception("NO_CHANGED_TESTS")
        }

      } catch (Exception err) {

        echo "Falling back to smoke tests due to: ${err}"

        stage('Smoke Tests') {
          try {
            yarnBuilder.yarn('setup')
            yarnBuilder.yarn('test:smoke')
          } catch (Exception smokeErr) {
            unstable("Smoke tests had failures: ${smokeErr}")
          }
        }
      }
    }
  }
}